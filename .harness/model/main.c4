specification {
  element system
  element component
  relationship uses
}
model {
  app = system "Codux" {
    description "Local-first AI coding workspace with desktop, mobile controller and headless host. Initial model covers app/crate boundaries and the verified terminal hyperlink flow."
    metadata {
      harness_id "128ed217-fb19-4dfe-bd27-02a18e92a906"
      brief "Local-first AI coding workspace with desktop, mobile controller and headless host. Initial model covers app/crate boundaries and the verified terminal hyperlink flow."
      source "fact"
      status "verified"
      evidence "9be201d7-4917-434b-9845-4987d91c2e62"
      version "1"
    }
    desktop = component "Codux Desktop" {
      description "Rust and GPUI workspace UI, terminal rendering, project/worktree orchestration and native desktop integration. Terminal layouts restore dormant panes; explicit selection starts shells and the power control stops sessions while retaining their panes."
      metadata {
        harness_id "42a580c4-143d-4093-9051-4601fc90d4a3"
        brief "Rust and GPUI workspace UI, terminal rendering, project/worktree orchestration and native desktop integration. Terminal layouts restore dormant panes; explicit selection starts shells and the power control stops sessions while retaining their panes."
        source "fact"
        status "verified"
        evidence "f01500b8-70ac-404d-879d-535593dcff91 52962a4d-75b5-42ef-8e63-6b07d57beed2 995870f7-d95d-46f7-9613-70210b3db7b4"
        version "2"
      }
      terminal_links = component "Terminal Hyperlinks" {
        description "Prefers the OSC 8 URI stored on a screen cell over plain URL detection and passes the complete target with the label column range."
        metadata {
          harness_id "df1d8550-9658-4875-adfd-6e26f1965590"
          brief "Prefers the OSC 8 URI stored on a screen cell over plain URL detection and passes the complete target with the label column range."
          source "fact"
          status "verified"
          evidence "431c1b31-6c67-41df-920e-c9e56f49808e"
          version "1"
        }
      }
    }
    runtime = component "Desktop Runtime" {
      description "Desktop runtime services and platform adapters for files, settings, updates, remote hosting and the shared Git, AI, memory and terminal engines."
      metadata {
        harness_id "fd9e63c2-396e-49db-8696-de8ace866d2c"
        brief "Desktop runtime services and platform adapters for files, settings, updates, remote hosting and the shared Git, AI, memory and terminal engines."
        source "fact"
        status "verified"
        evidence "7573f9b2-3925-4756-a26e-c48047c97ab6"
        version "1"
      }
      url_open = component "Native URL Opener" {
        description "Validates http, https and file URLs. Windows opens the full UTF-16 URL/path on a dedicated STA shell thread, avoiding GPUI message-loop reentrancy and preserving synchronous launch errors."
        metadata {
          harness_id "ce104158-bc15-4de0-bafb-3ea627a85dac"
          brief "Validates http, https and file URLs. Windows opens the full UTF-16 URL/path on a dedicated STA shell thread, avoiding GPUI message-loop reentrancy and preserving synchronous launch errors."
          source "fact"
          status "verified"
          evidence "e4b0ec07-e8e8-4414-a750-710153932ad6 6b22e619-c9c2-4e44-aec7-20b78f62c4cb"
          version "2"
        }
      }
    }
    agent = component "Headless Host" {
      description "Cross-platform CLI host with pairing, service lifecycle and remote projects, terminals, Git, AI history and memory."
      metadata {
        harness_id "e5417061-d84e-45a2-a29f-680965f765a0"
        brief "Cross-platform CLI host with pairing, service lifecycle and remote projects, terminals, Git, AI history and memory."
        source "fact"
        status "verified"
        evidence "a9a99a24-907b-4e1d-8d79-f0d508bf9f51"
        version "1"
      }
    }
